{
  "manifest_version": 3,
  "name": "Tab Home",
  "version": "1.0.0",
  "description": "A home for your Chrome tabs. Manage open tabs, favorites, and saved pages from your new tab page.",
  "permissions": ["tabs", "activeTab", "storage", "favicon", "bookmarks", "tabGroups"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Tab Home",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
